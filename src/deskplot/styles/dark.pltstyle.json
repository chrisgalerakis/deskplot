{
    "line": {
        "up_color": "#00ACFF",
        "down_color": "#e4003a",
        "color": "#ffed00",
        "width": 1.5
    },
    "data": {
        "candlestick": [
            {
                "decreasing": {
                    "fillcolor": "#e4003a",
                    "line": {
                        "color": "#e4003a"
                    }
                },
                "increasing": {
                    "fillcolor": "#00ACFF",
                    "line": {
                        "color": "#00ACFF"
                    }
                },
                "type": "candlestick"
            }
        ]
    },
    "layout": {
        "annotationdefaults": {
            "showarrow": false
        },
        "autotypenumbers": "strict",
        "colorway": [
            "#ffed00",
            "#ef7d00",
            "#e4003a",
            "#c13246",
            "#822661",
            "#48277c",
            "#005ca9",
            "#00aaff",
            "#9b30d9",
            "#af005f",
            "#5f00af",
            "#af87ff"
        ],
        "dragmode": "pan",
        "font": {
            "family": "JetBrains Mono, monospace",
            "size": 13,
            "color": "#6b7080"
        },
        "hoverlabel": {
            "align": "left",
            "bgcolor": "#1c1c1c",
            "bordercolor": "#3a3a3a",
            "font": {
                "size": 11,
                "family": "JetBrains Mono, monospace",
                "color": "#e0e0e0"
            }
        },
        "hovermode": "x",
        "legend": {
            "bgcolor": "rgba(0,0,0,0)",
            "orientation": "h",
            "x": 0.5,
            "xanchor": "center",
            "y": 1.0,
            "yanchor": "bottom",
            "font": {
                "size": 10,
                "color": "#888"
            },
            "itemclick": "toggle",
            "itemdoubleclick": "toggleothers"
        },
        "paper_bgcolor": "#06080e",
        "plot_bgcolor": "#06080e",
        "newshape": {
            "line": {
                "color": "#f0c040",
                "width": 2
            },
            "fillcolor": "rgba(240,192,64,0.12)"
        },
        "xaxis": {
            "automargin": true,
            "autorange": true,
            "rangeslider": {
                "visible": false
            },
            "showgrid": true,
            "showline": false,
            "tickfont": {
                "size": 11,
                "color": "#6b7080"
            },
            "title_font": {
                "size": 12,
                "color": "#6b7080"
            },
            "zeroline": false,
            "title": {
                "standoff": 20
            },
            "gridcolor": "rgba(255,255,255,0.05)",
            "griddash": "dot",
            "gridwidth": 0.5,
            "zerolinecolor": "rgba(255,255,255,0.08)"
        },
        "yaxis": {
            "anchor": "x",
            "automargin": true,
            "fixedrange": false,
            "zeroline": false,
            "showgrid": true,
            "showline": false,
            "side": "right",
            "title": {
                "standoff": 20
            },
            "tickfont": {
                "size": 11,
                "color": "#6b7080"
            },
            "title_font": {
                "size": 12,
                "color": "#6b7080"
            },
            "gridcolor": "rgba(255,255,255,0.05)",
            "griddash": "dot",
            "gridwidth": 0.5,
            "zerolinecolor": "rgba(255,255,255,0.08)"
        }
    }
}
